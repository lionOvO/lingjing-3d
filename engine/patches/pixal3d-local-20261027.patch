     def forward(self, input: VarLenTensor) -> VarLenTensor:
+        feats = input.feats
+        if not torch.is_grad_enabled() and feats.numel() * feats.element_size() > 32 * 1024 * 1024:
+            # This is the disposable expansion buffer between the two MLP
+            # linears. Reuse it during inference so GELU does not allocate a
+            # second full-size tensor (hundreds of MB for 1024 texture SLats).
+            bytes_per_row = max(1, feats.shape[-1] * feats.element_size())
+            rows_per_chunk = max(1, (16 * 1024 * 1024) // bytes_per_row)
+            for start in range(0, feats.shape[0], rows_per_chunk):
+                end = min(start + rows_per_chunk, feats.shape[0])
+                feats[start:end].copy_(super().forward(feats[start:end]))
+            return input
         return input.replace(super().forward(input.feats))
 
 
