+    @staticmethod
+    def remove_floater_by_edges(vertices, faces, ratio=0.005):
+        """Select by edge-connected face count without a MeshLab geometry copy."""
+        if len(faces) == 0:
+            return vertices[:0].copy(), faces.copy()
+        # Store each unoriented vertex-index edge in one uint64, retaining all
+        # incident faces even when more than two faces share an edge.
+        keys = np.empty((len(faces), 3), dtype=np.uint64)
+        for column, (a, b) in enumerate(((0, 1), (1, 2), (2, 0))):
+            keys[:, column] = np.minimum(faces[:, a], faces[:, b])
+            keys[:, column] <<= np.uint64(32)
+            keys[:, column] |= np.maximum(faces[:, a], faces[:, b]).astype(np.uint64)
+        keys = keys.reshape(-1)
+        order = np.argsort(keys)
+        keys = keys[order]
+        shared = np.flatnonzero(keys[1:] == keys[:-1])
+        del keys
+        first = (order[shared] // 3).astype(np.int32)
+        second = (order[shared + 1] // 3).astype(np.int32)
+        del order, shared
+        graph = coo_matrix((np.ones(len(first), dtype=np.bool_), (first, second)),
+                           shape=(len(faces), len(faces))).tocsr()
+        del first, second
+        _, labels = connected_components(graph, directed=False, return_labels=True)
+        del graph
+        counts = np.bincount(labels)
+        # MeshLab truncates the relative count threshold to an integer and selects
+        # strictly smaller components. Preserve that existing policy.
+        keep = counts[labels] >= int(counts.max() * ratio)
+        del labels, counts
+        new_faces = faces[keep]
+        referenced, inverse = np.unique(new_faces, return_inverse=True)
+        return np.ascontiguousarray(vertices[referenced]), np.ascontiguousarray(inverse.reshape(-1, 3), dtype=faces.dtype)
+
+    @staticmethod
+    def clean_mesh_faces(vertices, faces):
+        # Test exact area in float64 without discarding small but valid triangles.
+        triangles = vertices[faces].astype(np.float64)
+        cross = np.cross(triangles[:, 1] - triangles[:, 0], triangles[:, 2] - triangles[:, 0])
+        valid = np.any(cross != 0, axis=1)
+        faces = faces[valid]
+        # Compare positions without welding split vertices or removing reverse faces.
+        _, position_ids = np.unique(vertices, axis=0, return_inverse=True)
+        keys = position_ids[faces]
+        rotation = keys.argmin(axis=1)
+        keys = np.take_along_axis(keys, (rotation[:, None] + np.arange(3)) % 3, axis=1)
+        _, first = np.unique(keys, axis=0, return_index=True)
+        return np.ascontiguousarray(faces[np.sort(first)])
