APP_ENV=production
MYSQL_DATABASE=digital_human
MYSQL_USER=app
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
CORS_ORIGINS=http://localhost:8080
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
QWEN2VL_URL=http://qwen2vl:8002
# Real multimodal provider endpoint (OpenAI-compatible chat/completions).
# Leave empty only when the qwen2vl service is intentionally disabled.
QWEN2VL_PROVIDER_URL=
QWEN2VL_API_KEY=
QWEN2VL_MODEL=qwen-vl-max

# Optional image-preparation recognition/review (official vision model).
# Images are sent to this provider only when the user starts AI assistance.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PROXY=
# Optional semantic embedding provider. It must return an OpenAI-style
# /embeddings response with dimensions matching the Milvus collection.
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
TRELLIS_URL=http://trellis:8001
AGENT_HTTP_TIMEOUT=120
GENERATION_HTTP_TIMEOUT=1860
GENERATION_SERVICE_RETRIES=2
GENERATION_RETRY_BACKOFF=0.25
TRELLIS2_MODEL_PATH=/models/trellis2
TRIPOSR_MODEL_PATH=/models/triposr
TRELLIS_ARTIFACT_DIR=/artifacts
# Required for real inference. The command must write a GLB to {output_file}.
# Example: python /models/run_triposr.py --input {input_image} --output {output_file}
TRELLIS_INFERENCE_COMMAND=
TRELLIS_INFERENCE_TIMEOUT=1800
# Optional local ComfyUI bridge for the TRELLIS2 high-quality tier.
# ComfyUI must be reachable from the trellis container at this URL.
TRELLIS_PROVIDER=command
TRELLIS_COMFY_ENABLED=false
TRELLIS_COMFY_URL=http://host.docker.internal:8188
TRELLIS_COMFY_WORKFLOW=/app/workflow_6gb.json
TRELLIS_COMFY_OUTPUT_DIR=./tmp/comfy-output
TRELLIS_COMFY_HOST_OUTPUT_DIR=./tmp/comfy-output
TRELLIS_COMFY_TIMEOUT=2400
TRELLIS_COMFY_POLL_INTERVAL=2
# Experimental: route only high_quality GLB jobs through Microsoft's public
# Hugging Face TRELLIS.2 demo. Do not enable for sensitive images or production.
TRELLIS_HF_SPACE_ENABLED=false
TRELLIS_HF_SPACE_ID=microsoft/TRELLIS.2
# Optional Hugging Face Read token for the public Space quota. Keep secret.
HF_TOKEN=
# Set to 1 only for fully local/offline inference. Keep 0 for the public
# TRELLIS.2 Space provider.
HF_HUB_OFFLINE=0
# Host directory containing model weights and the inference runner.
TRELLIS_MODEL_DIR=./models
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-this-minio-password
MINIO_BUCKET=digital-human
MINIO_SECURE=false
UPLOAD_MAX_SIZE_MB=20
FRONTEND_PORT=8080
# Required only when package registries need an outbound proxy during image builds.
# For Clash Verge with LAN access enabled, replace the host IP and port as needed.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,host.docker.internal,mysql,redis,minio,milvus,etcd,trellis,qwen2vl,api

# Aliyun PNVS SMS login (server-side only; same variable names as Tongpin)
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_SMS_SIGN_NAME=
ALIBABA_SMS_TEMPLATE_CODE=
ALIBABA_SMS_REGION=cn-hangzhou
ALIBABA_SMS_SCHEME_NAME=
